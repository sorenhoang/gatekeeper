# Buffer access-log writes: one write per 32k or 200ms instead of one per
# request. flush stays under the ~300ms the Phase 4 log tests wait.
FILE=nginx/nginx.conf
FROM=access_log /var/log/nginx/access.log gatekeeper if=$loggable;
TO=access_log /var/log/nginx/access.log gatekeeper buffer=32k flush=200ms if=$loggable;
